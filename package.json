{
  "name": "turnbase-game-7wonders-duel-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "7 Wonders Duel game frontend (React) — bundled to frontend/main.js in the game bundle.",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "esbuild src/main/ts/main.tsx --bundle --format=esm --target=es2022 --minify --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=target/bundle/frontend/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/main/ts src/test/ts dev vite.config.ts",
    "format": "prettier --write \"{src,dev}/**/*.{ts,tsx}\" vite.config.ts",
    "format:check": "prettier --check \"{src,dev}/**/*.{ts,tsx}\" vite.config.ts",
    "test": "vitest run --coverage",
    "dev": "scripts/dev.sh",
    "dev:seed": "scripts/dev.sh",
    "licenses": "npx --yes license-checker-rseidelsohn@5.0.1 --production --excludePrivatePackages --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;OFL-1.1' --excludePackages '@turnbase-platform/gdk@0.1.0' --csv --out licenses.csv"
  },
  "dependencies": {
    "@turnbase-platform/gdk": "https://github.com/turnbase-platform/turnbase-sdk/releases/download/v0.1.0/turnbase-platform-gdk-0.1.0.tgz",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "ws": "8.21.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
